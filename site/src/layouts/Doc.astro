---
import Base from "./Base.astro";
import { BASE, absolute, breadcrumbs, howToInstall } from "../lib";
const { frontmatter } = Astro.props;
const { title, description, slug, source } = frontmatter;
const path = `${slug}/`;
const nodes: object[] = [
  breadcrumbs([{ name: title, path }]),
  { "@type": "WebPage", name: title, description, url: absolute(path), inLanguage: "en" },
];
if (slug === "install") nodes.push(howToInstall());
---
<Base title={title} description={description} path={path} type="article" nodes={nodes}>
  <article class="doc">
    <div class="col">
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="prose"><slot /></div>
      <p class="docfoot"><a href={source}>Edit on GitHub</a> · <a href={`${BASE}${slug}.md`}>Markdown</a></p>
    </div>
  </article>
</Base>
