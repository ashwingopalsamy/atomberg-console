---
import Base from "./Base.astro";
import { BASE, absolute, breadcrumbs, howToInstall } from "../lib";
const { frontmatter } = Astro.props;
const { title, description, slug, source } = frontmatter;
const path = `${slug}/`;
const nodes: object[] = [
  breadcrumbs([{ name: title, path }]),
  { "@type": "WebPage", name: title, description, url: absolute(path), inLanguage: "en" },
];
if (slug === "install") nodes.push(howToInstall());
---
<Base title={title} description={description} path={path} type="article" nodes={nodes}>
  <header class="head" transition:name="copy" transition:animate="none">
    <span class="mini" transition:name="tile" transition:animate="none">
      <img src={`${BASE}brand/tile-xl.png`} alt="" width="1280" height="1280" />
      <img src={`${BASE}brand/glyph-xl.png`} alt="" width="1280" height="1280" />
    </span>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <p class="meta"><a href={source}>Edit on GitHub</a><a href={`${BASE}${slug}.md`}>Markdown</a></p>
  </header>
  <div class="scroll" tabindex="0" role="region" aria-label={`${title}, full text`} transition:name="content" transition:animate="none">
    <div class="prose"><slot /></div>
  </div>
</Base>
