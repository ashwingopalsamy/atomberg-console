---
import Base from "../layouts/Base.astro";
import { BASE, faq, faqPage, breadcrumbs, absolute } from "../lib";
const nodes = [
  breadcrumbs([{ name: "FAQ", path: "faq/" }]),
  { "@type": "WebPage", name: "FAQ", url: absolute("faq/"), inLanguage: "en" },
  faqPage(),
];
---
<Base title="FAQ" description="Short answers about Atomberg Console: the 100-call limit, local control, credentials, what it connects to, and whether it is official." path="faq/" nodes={nodes}>
  <header class="head" transition:name="copy" transition:animate="none">
    <span class="mini" transition:name="tile" transition:animate="none">
      <img src={`${BASE}brand/tile-xl.png`} alt="" width="1280" height="1280" />
      <img src={`${BASE}brand/glyph-xl.png`} alt="" width="1280" height="1280" />
    </span>
    <h1>FAQ</h1>
    <p class="lede">Short answers to the things people ask first.</p>
    <p class="meta"><a href={`${BASE}faq.md`}>Markdown</a></p>
  </header>
  <div class="scroll faq" tabindex="0" role="region" aria-label="Questions and answers" transition:name="content" transition:animate="none">
    {faq.map((f) => (
      <details id={f.id}>
        <summary>{f.q}<span class="pm" aria-hidden="true"></span></summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
  <script>
    // open the question a link points at
    document.addEventListener("astro:page-load", () => {
      const target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
      if (target instanceof HTMLDetailsElement) target.open = true;
    });
  </script>
</Base>
