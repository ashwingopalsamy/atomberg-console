---
import Base from "../layouts/Base.astro";
import { BASE, REPO, faq, faqPage, howToInstall, release, webSite, softwareApplication, sourceCode } from "../lib";
import knowledge from "../generated/knowledge.json";
import * as Install from "../content-md/install.md";
import * as Budget from "../content-md/call-budget.md";
import * as Local from "../content-md/local-control.md";
import * as Privacy from "../content-md/privacy.md";

const lede = Object.fromEntries(knowledge.pages.map((p) => [p.slug, p.description])) as Record<string, string>;
const nodes = [webSite(), softwareApplication(), sourceCode(), howToInstall(), faqPage()];
const sections = [
  { id: "install", title: "Install", lede: lede["install"], Body: Install.Content },
  { id: "budget", title: "The 100-call budget", lede: lede["call-budget"], Body: Budget.Content },
  { id: "local", title: "Local control", lede: lede["local-control"], Body: Local.Content },
  { id: "privacy", title: "Privacy", lede: lede["privacy"], Body: Privacy.Content },
];
const layer = `${BASE}brand/glyph-xl.png`;
const brew = "brew install --cask ashwingopalsamy/tap/atomberg-console";
// The DMG itself when the release has one; the source otherwise. Never an empty releases page.
const primary = release?.dmgUrl
  ? { href: release.dmgUrl, label: "Download", download: true }
  : { href: REPO, label: "Get the source", download: false };
const github = "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z";
const nav: { id: string; label: string; icon: string[] }[] = [
  { id: "install", label: "Install", icon: ["M12 4v11", "M7.5 10.5 12 15l4.5-4.5", "M5 19.5h14"] },
  { id: "budget", label: "Budget", icon: ["M4 16a8 8 0 1 1 16 0", "M12 16l3.5-4.5", "M12 16h.01"] },
  { id: "local", label: "Local control", icon: ["M2.5 9a14 14 0 0 1 19 0", "M5.5 12.5a9.5 9.5 0 0 1 13 0", "M8.7 16a5 5 0 0 1 6.6 0", "M12 19.4h.01"] },
  { id: "privacy", label: "Privacy", icon: ["M12 3.5 19 6.5v5c0 4.3-2.9 7.6-7 9.5-4.1-1.9-7-5.2-7-9.5v-5z"] },
  { id: "faq", label: "FAQ", icon: ["M9.6 9.6a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1.1.9-1.1 1.7", "M12 17h.01", "M3 12a9 9 0 1 0 18 0 9 9 0 1 0-18 0"] },
];
---
<Base
  home
  title="Atomberg Console"
  description="A macOS menu bar app for your Atomberg fans, purifiers and locks. Controls fans over Wi‑Fi first and calls one cloud host as a fallback."
  nodes={nodes}
>
  <a class="skip" href="#main">Skip to content</a>

  <header class="top">
    <a class="rb logo" href="#top" aria-label="Atomberg Console, top"><img class="spin" src={layer} alt="" width="1280" height="1280" /></a>
    <nav class="island" aria-label="Sections">
      <span class="hl" aria-hidden="true"></span>
      {nav.map((n) => (
        <a href={`#${n.id}`} data-s={n.id} aria-label={n.label}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{n.icon.map((d) => <path d={d} />)}</svg>
          <span>{n.label}</span>
        </a>
      ))}
    </nav>
    <span class="sep" aria-hidden="true"></span>
    <a class="rb gh" href={REPO} rel="noopener" aria-label="Atomberg Console on GitHub"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={github} /></svg></a>
  </header>

  <main id="main">
    <section id="top" class="hero">
      <div class="copy">
        <h1><span class="hl1">All your Atomberg devices,</span> <span class="hl1 dim">in the menu bar.</span></h1>
        <p>Fans, purifiers and locks, one click away. Fans answer over your Wi‑Fi first, and the app talks to nobody but Atomberg.</p>
      </div>
      <div class="stage">
        <button class="fan" type="button" aria-label="Spin the fan"><img class="spin" src={layer} alt="" width="1280" height="1280" /></button>
      </div>
      <div class="cta">
        <div class="btns">
          <a class="btn solid dl" href={primary.href}>
            {primary.download && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="da"><path d="M12 4v11" /><path d="M7.5 10.5 12 15l4.5-4.5" /></g><path d="M5 19.5h14" /></svg>
            )}
            <span>{primary.label}</span>
          </a>
          {release?.brew && (
            <button class="btn brewbtn" type="button" data-copy={brew} aria-label="Copy the Homebrew install command">
              <svg class="mug" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 9.5h9.5v8a3 3 0 0 1-3 3H8.5a3 3 0 0 1-3-3z" /><path d="M15 11.5h1.4a2.4 2.4 0 0 1 0 4.8H15" /><path d="M6 9.5a2.1 2.1 0 0 1 1.4-3.8 2.7 2.7 0 0 1 4.8-.6 2.2 2.2 0 0 1 3 1.8" /></svg>
              <svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              <span data-label>Homebrew</span>
            </button>
          )}
          <a class="btn" href="#install"><span class="wide">Other ways to download</span><span class="narrow">More ways</span></a>
        </div>
        <p class="fine">macOS 26 or later · Unofficial, not affiliated with Atomberg</p>
      </div>
    </section>

    {sections.map(({ id, title, lede, Body }) => (
      <section id={id} class="sec" aria-labelledby={`h-${id}`}>
        <div class="side">
          <h2 id={`h-${id}`}>{title}</h2>
          <p>{lede}</p>
        </div>
        <div class="body"><Body /></div>
      </section>
    ))}

    <section id="faq" class="sec" aria-labelledby="h-faq">
      <div class="side">
        <h2 id="h-faq">FAQ</h2>
        <p>Short answers to the things people ask first.</p>
      </div>
      <div class="body faq">
        {faq.map((f, i) => (
          <details id={f.id} open={i === 0}>
            <summary>{f.q}<span class="pm" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="sign">
    <span class="by">
      <span>Built by</span>
      <a class="nm" href="https://ashwingopalsamy.in"><img src={`${BASE}brand/pfp.jpg`} alt="" width="26" height="26" /><span>Ashwin Gopalsamy</span></a>
    </span>
    <span class="dot" aria-hidden="true">·</span>
    <span>No rights reserved</span>
    <span class="dot" aria-hidden="true">·</span>
    <span>{new Date().getFullYear()}</span>
  </footer>

  <script>
    import "../scripts/page";
  </script>
</Base>
