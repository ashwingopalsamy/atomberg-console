---
import Base from "../layouts/Base.astro";
import { BASE, REPO, webSite, softwareApplication, sourceCode } from "../lib";

const nodes = [webSite(), softwareApplication(), sourceCode()];
const brew = "brew install --cask ashwingopalsamy/tap/atomberg-console";
---
<Base
  home
  bare
  title="Atomberg Console"
  description="An unofficial macOS menu bar app for Atomberg fans, purifiers and locks. Controls fans over your Wi-Fi first, calls one cloud host as a fallback, and spends at most one of the 100 daily calls per command."
  nodes={nodes}
>
  <div class="screen">
    <header class="bar">
      <button class="logo" type="button" aria-label="Atomberg Console. Tap to turn the blades.">
        <img src={`${BASE}brand/tile.png`} alt="" width="88" height="88" />
        <img class="glyph" src={`${BASE}brand/glyph.png`} alt="" width="88" height="88" />
      </button>
      <a class="round" href={REPO} rel="noopener" aria-label="Atomberg Console on GitHub"><svg class="i"><use href="#i-github" /></svg></a>
    </header>

    <div class="words">
      <h1>Atomberg Console is a small menu bar app for Atomberg fans, purifiers and locks.</h1>
      <p>It controls fans over your Wi‑Fi and only reaches for Atomberg's cloud when it has to, so an ordinary day costs about six of the 100 calls the API allows.</p>
      <p>It contacts one server and your fans, nothing else. There are no accounts, analytics or updater, and <a href={REPO}>the source is public</a>, so you can <a href={`${BASE}privacy/`}>check</a>.</p>
      <div class="actions">
        <a class="btn solid" href={`${REPO}/releases/latest`}>Download</a>
        <button class="btn" type="button" data-copy={brew} aria-label="Copy the Homebrew install command">
          <span>Copy brew command</span>
          <svg class="i copy"><use href="#i-copy" /></svg><svg class="i ok"><use href="#i-check" /></svg>
        </button>
      </div>
      <p class="fine">macOS 26 or later. Unofficial, and not affiliated with Atomberg.</p>
    </div>

    <footer class="note">
      <a href={`${BASE}install/`}>Install</a>
      <a href={`${BASE}call-budget/`}>Budget</a>
      <a href={`${BASE}privacy/`}>Privacy</a>
      <a href={`${BASE}faq/`}>FAQ</a>
    </footer>
  </div>

  <script>
    import "../scripts/home";
  </script>
</Base>
