---
import { BASE, REPO } from "../lib";
const { path = "" } = Astro.props;
const links = [
  ["install/", "Install"],
  ["call-budget/", "Budget"],
  ["local-control/", "Local control"],
  ["privacy/", "Privacy"],
  ["faq/", "FAQ"],
];
---
<header class="bar" transition:persist="bar">
  <a class="word" href={BASE}>Atomberg Console</a>
  <nav class="nav" aria-label="Main">
    <span class="pill" aria-hidden="true"></span>
    {links.map(([href, label]) => <a href={`${BASE}${href}`} aria-current={path === href ? "page" : undefined}>{label}</a>)}
  </nav>
  <a class="round" href={REPO} rel="noopener" aria-label="Atomberg Console on GitHub"><svg class="i"><use href="#i-github" /></svg></a>
</header>
<script>
  import "../scripts/nav";
</script>
